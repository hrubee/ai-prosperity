# Copy to .env and fill. NEVER commit the real .env.

# Database
DATABASE_URL=postgresql+psycopg2://aiprosperity:aiprosperity@localhost:5432/aiprosperity

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=168
OTP_TTL_MINUTES=10

# Secret encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
SECRET_ENCRYPTION_KEY=

# Delta Exchange (India)
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_SANDBOX=1
RISK_PER_TRADE=0.02

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_BASE_URL=https://api.dodopayments.com
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_PRO=

# Frontend origin / CORS
APP_ORIGIN=https://app.diffraction.in

# Brain → signal bus auth
INTERNAL_SIGNAL_TOKEN=change-me

# Worker
WORKER_POLL_SECONDS=2
WORKER_MAX_CONCURRENCY=16
WEEK_TZ_OFFSET_MIN=330
