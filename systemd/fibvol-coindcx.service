[Unit]
Description=FibVOL 15X Volume Spike Fibonacci CoinDCX Live Executor
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ai-prosperity
ExecStart=/root/ai-prosperity/.venv/bin/python /root/ai-prosperity/scripts/stream_fibvol_coindcx.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
